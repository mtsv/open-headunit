<?xml version="1.0" encoding="utf-8"?>
<!-- The <-> button of "Hide Android Auto bar": a solid #282A2E fill and an opaque #43464C ring, so 100% opacity is fully solid. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#282A2E" />
    <stroke
        android:width="1.5dp"
        android:color="#43464C" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- The <-> button of "Hide Android Auto bar": a solid #282A2E fill and an opaque ring (the Home button's 25% white over it), so 100% opacity is fully solid. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#282A2E" />
    <stroke
        android:width="1.5dp"
        android:color="#5E5F62" />
</shape>
